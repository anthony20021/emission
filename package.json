{
  "name": "jeuemission",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jeu à 2 joueurs : devine les mots qui seront prononcés dans un extrait d'émission",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "transcribe": "node scripts/transcribe.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "vite": "^8.3.2"
  }
}
